# Copy to server/.env (gitignored) for local runs.
# On Render: Dashboard → Environment → add the same keys (never commit real secrets).

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://...
JWT_SECRET=dev-secret
JWT_REFRESH_SECRET=dev-refresh-secret

# Footwear background removal (server-only)
# Used by: POST /api/articles/remove-background
# Get key: https://www.remove.bg/dashboard#api-key
# Rotate if this key was ever committed in the mobile app.
REMOVE_BG_API_KEY=YOUR_REMOVE_BG_API_KEY

# Cloudinary (article / profile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phone OTP (Android/iOS → MSG91)
MSG91_AUTH_KEY=your_auth_key
MSG91_FLOW_ID=your_sms_flow_or_template_id
MSG91_OTP_VAR=number

# Optional Maps (server directions / geocode helpers)
# GOOGLE_MAPS_API_KEY=
